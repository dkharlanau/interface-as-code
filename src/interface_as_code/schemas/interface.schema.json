{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dkharlanau.github.io/interface-as-code/schema/interface.schema.json",
  "title": "Interface as Code specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "interface",
    "trigger",
    "contract",
    "delivery",
    "mapping",
    "retry",
    "monitoring",
    "reconciliation"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "source",
        "target",
        "mode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "source": {
          "$ref": "#/$defs/endpoint"
        },
        "target": {
          "$ref": "#/$defs/endpoint"
        },
        "mode": {
          "enum": [
            "sync",
            "async",
            "batch"
          ]
        },
        "pattern": {
          "enum": [
            "request-response",
            "event-driven",
            "message-driven",
            "file-transfer",
            "scheduled-batch"
          ]
        },
        "criticality": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "event": {
          "type": "string"
        },
        "schedule": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "enum": [
            "IDoc",
            "SOAP",
            "REST",
            "OData",
            "Kafka",
            "JMS",
            "CSV",
            "JSON",
            "XML",
            "EDI",
            "File"
          ]
        },
        "message_type": {
          "type": "string"
        },
        "basic_type": {
          "type": "string"
        },
        "schema_ref": {
          "type": "string"
        },
        "content_type": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guarantee",
        "idempotency"
      ],
      "properties": {
        "guarantee": {
          "enum": [
            "at-most-once",
            "at-least-once",
            "effectively-once",
            "best-effort"
          ]
        },
        "ordering": {
          "enum": [
            "none",
            "global",
            "per-key"
          ]
        },
        "idempotency": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "key": {
              "type": "string"
            }
          }
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "none",
            "manual",
            "automatic"
          ]
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "backoff": {
          "type": "string"
        },
        "dead_letter": {
          "type": "string"
        },
        "replay": {
          "type": "string"
        }
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "support_route"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 2
        },
        "support_route": {
          "type": "string",
          "minLength": 2
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "business_key": {
          "type": "string"
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "frequency",
        "source_of_truth"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "frequency": {
          "type": "string",
          "minLength": 2
        },
        "source_of_truth": {
          "type": "string",
          "minLength": 2
        },
        "comparison": {
          "type": "string"
        }
      }
    },
    "sla": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_latency": {
          "type": "string"
        },
        "recovery_target": {
          "type": "string"
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "fixture": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 2
        },
        "object": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        }
      }
    }
  }
}
